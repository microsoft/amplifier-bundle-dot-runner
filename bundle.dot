// dot-runner: the shared engine that executes ".dot" pipeline files step by step —
// the reusable machinery that Attractor and other pipeline tools are built on top of.
digraph dot_runner {
    rankdir=LR
    fontname="Helvetica"
    fontsize=12
    label="The Dot-Runner Engine\nThe shared engine that runs \".dot\" pipeline workflows, step by step"
    labelloc=t
    labeljust=c
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="d2350be26c891a0adf7ad03c5eb8f98b978c6965fc72c344601b5a49b08ad2c5"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    root_dot_runner [label="The Dot-Runner Engine v0.1.0\n0 tools · 0 agents\n~136 tok aggregate", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", penwidth=2]

    subgraph cluster_behaviors {
        label="What This Repo Provides"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        beh_dot_runner_core [label="Core Pipeline Toolkit\n1 tools\n~52 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
    }

    subgraph cluster_modules {
        label="The Engine's Working Parts"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        mod_loop_pipeline [label="Core Execution Engine\n(loop-pipeline)", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
        mod_pipeline_runner [label="Command-Line Launcher\n(pipeline-runner)", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
        mod_remote_source [label="Remote Pipeline Fetcher\n(remote-source)", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
    }

    subgraph cluster_legend {
        label="Legend"
        style="filled"
        fillcolor="white"
        color="#cccccc"
        fontsize=9

        leg_root [label="Main package (starting point)", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", fontsize=9]
        leg_behavior [label="Add-on capability", shape=box, fillcolor="#e0f2f1", style="filled,rounded", fontsize=9]
        leg_agent [label="AI specialist", shape=box, fillcolor="#c8e6c9", style="filled,rounded", fontsize=9]
        leg_module [label="Building-block component", shape=box, fillcolor="#bbdefb", style="filled,rounded", fontsize=9]
        leg_provider [label="AI model connection", shape=box, fillcolor="#e0e0e0", style="filled,rounded", fontsize=9]
        leg_context [label="Reference document", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_standalone [label="Self-contained package", shape=box, fillcolor="#80cbc4", style="filled,rounded", fontsize=9]
        leg_experiment [label="Experimental / in progress", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_ext_cost [label="Borrowed from elsewhere, adds hidden cost", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2, fontsize=9]
        leg_ext_muted [label="Borrowed from elsewhere, no extra cost", shape=box, fillcolor="#f5f5f5", style="dashed", fontsize=9]
    }

    disclaimer [label="How to read the numbers:\n~4 characters of text ≈ 1 \"token\"\nSolid border = built into this repo (counted)\nDashed + red = borrowed from elsewhere, hidden cost (not counted)\nDashed + gray = borrowed from elsewhere, no added cost\nDoes not include costs from sub-tasks or things loaded only while running", shape=note, fillcolor="#eceff1", style="filled", fontsize=9]


    root_dot_runner -> beh_dot_runner_core [label="composes"]
}